# Murphy 互动工具集 - 环境变量配置示例
# 本地开发：复制此文件为 .env.local 并填入实际值
# 容器部署：复制此文件为 .env 并填入实际值

# ── Compose 项目名（同一服务器多实例时必须不同） ──
COMPOSE_PROJECT_NAME=scansign

# ── 应用端口（宿主机映射端口，容器内始终 3000） ──
APP_PORT=3004

# ── 二维码中使用的基础 URL ──
# 开发时使用局域网 IP，生产时使用域名（含 https://）
NEXT_PUBLIC_BASE_URL=https://sign.murphylan.cloud

# ── PostgreSQL ──
# 本地开发：DATABASE_URL 指向本机 Postgres。
# 容器：compose.yml 会向 app 容器注入指向 db 容器的 DATABASE_URL；与这里一行是否一致无关，
# 勿在宿主机用「pnpm db:push」连 localhost 去同步容器里的库——应在容器内执行 drizzle-kit push。
POSTGRES_DB=scansign
POSTGRES_USER=scansign
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/scansign"

# ── Session 配置 ──
SESSION_COOKIE_NAME=murphy_session
SESSION_EXPIRY_DAYS=7

# ── 管理员账户（手机号验证码登录） ──
# 首次以该手机号登录即自动创建为管理员；设为你自己的手机号
ADMIN_PHONE=13800000000

# ── 运营台（可选） ──
# 不填时默认与 ADMIN_PHONE 相同；该手机号登录后可访问 /ops/console（桌面端）
# OPS_SUPER_USER_PHONE=13800000000

# ── 短信服务商 ──
# 留空 = Mock：验证码打印到服务端日志（本地/联调用）
# 生产可选：aliyun（阿里云短信认证·个人可开通）/ tencent（腾讯云）/ unisms（合一短信）
# SMS_PROVIDER=aliyun
# 各服务商密钥（按所选填写）：
# ALIYUN_ACCESS_KEY_ID= / ALIYUN_ACCESS_KEY_SECRET= / ALIYUN_SMS_SIGN_NAME= / ALIYUN_SMS_TEMPLATE_CODE=
# TENCENTCLOUD_SECRET_ID= / TENCENTCLOUD_SECRET_KEY= / TENCENT_SMS_SDK_APP_ID= / TENCENT_SMS_SIGN_NAME= / TENCENT_SMS_TEMPLATE_ID=
# UNISMS_ACCESS_KEY_ID= / UNISMS_SIGNATURE= / UNISMS_TEMPLATE_ID=
