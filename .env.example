# Rally 活动互动平台 - 环境变量配置示例
# 本地开发：复制此文件为 .env.local 并填入实际值
# 容器部署：复制此文件为 .env 并填入实际值

# ── Compose 项目名（同一服务器多实例时必须不同） ──
COMPOSE_PROJECT_NAME=scansign

# ── 应用端口（宿主机映射端口，容器内始终 3000） ──
APP_PORT=3004

# ── 部署模式提示 ──
# 本项目使用「镜像 + compose」方式部署，与 worksync / timeslot 一致：
#   1. 开发机:  ./scripts/build-image.sh && ./scripts/push-image.sh
#   2. 服务器:  bash scripts/install.sh --db-mode shared --domain sign.murphylan.cloud
# 默认 compose.yml 使用 zot.murphylan.cloud/murphy/scansign:latest 镜像，无需在服务器构建。

# ── 二维码中使用的基础 URL ──
# 开发时使用局域网 IP，生产时使用域名（含 https://）
NEXT_PUBLIC_BASE_URL=https://sign.murphylan.cloud

# ── PostgreSQL ──
# 本地开发：DATABASE_URL 指向本机 Postgres。
# 容器：compose.yml 会向 app 容器注入指向 db 容器的 DATABASE_URL；与这里一行是否一致无关，
# 勿在宿主机用「pnpm db:push」连 localhost 去同步容器里的库——应在容器内执行 drizzle-kit push。
POSTGRES_DB=scansign
POSTGRES_USER=scansign
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/scansign"

# ── Session 配置 ──
SESSION_COOKIE_NAME=murphy_session
SESSION_EXPIRY_DAYS=7

# ── 管理员账户（首次启动时自动创建） ──
# 请修改为你自己的邮箱和强密码！
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_password_here

# ── 运营台（可选） ──
# 不填时默认与 ADMIN_EMAIL 相同；登录该邮箱后访问 /ops/console（桌面端）
# OPS_SUPER_USER_EMAIL=admin@example.com

# ── Playwright E2E（可选，默认复用 ADMIN_EMAIL / ADMIN_PASSWORD） ──
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://localhost:3000
